{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "supercharged",
    "packageManager": "pnpm@11.8.0",
    "type": "module",
    "engines": {
        "node": "^24.16.0",
        "pnpm": "11.8.0"
    },
    "pi": {
        "extensions": [
            "./dist/index.js"
        ]
    },
    "scripts": {
        "build": "rolldown -c",
        "test": "node --test",
        "format": "oxfmt \"**/*.{js,json,md,ts}\"",
        "lint": "oxlint --fix",
        "typecheck": "tsc --noEmit"
    },
    "imports": {
        "#src/*.ts": "./src/*.ts",
        "#tests/*.ts": "./tests/*.ts"
    },
    "dependencies": {
        "picomatch": "^4.0.7",
        "tree-sitter-bash": "^0.25.1",
        "tslib": "^2.8.1",
        "typebox": "^1.3.34",
        "web-tree-sitter": "^0.27.0"
    },
    "devDependencies": {
        "@earendil-works/pi-agent-core": "^1.0.1",
        "@earendil-works/pi-coding-agent": "^1.0.1",
        "@earendil-works/pi-tui": "^1.0.1",
        "@types/node": "^26.6.3",
        "@types/picomatch": "^4.0.3",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "^7.0.2003",
        "rolldown": "^1.2.12",
        "typescript": "^7.0.2"
    }
}
